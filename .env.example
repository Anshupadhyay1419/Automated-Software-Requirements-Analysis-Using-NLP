# Copy this file to .env (same folder). Every value is optional.

# Where Ollama runs on this computer.
OLLAMA_URL=http://127.0.0.1:11434

# Leave empty to auto-pick an installed Qwen instruct model.
# You can also change the model later on the Settings page.
OLLAMA_MODEL=

# Seconds to wait for one model reply.
OLLAMA_TIMEOUT=180

# Sentence-transformers model for duplicate detection.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Default cosine similarity needed to flag two requirements (0 to 1).
SIMILARITY_THRESHOLD=0.60

# SQLite database location.
DATABASE_URL=sqlite:///backend/data/app.db
